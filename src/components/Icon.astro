---
// Inline SVG icons (stroke icons use currentColor so they follow the text color).
interface Props {
  name: 'email' | 'github' | 'scholar' | 'orcid' | 'linkedin' | 'x' | 'cv' | 'arrow' | 'external' | 'copy' | 'code' | 'paper';
  size?: number;
}
const { name, size = 18 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'email' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>)}
  {name === 'github' && (
    <path fill="currentColor" stroke="none" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a10.9 10.9 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
  )}
  {name === 'scholar' && (<><path d="M2 9.5 12 3l10 6.5-10 6.5Z" /><path d="M6 12v4.5c0 1.5 2.7 3 6 3s6-1.5 6-3V12" /></>)}
  {name === 'orcid' && (<><circle cx="12" cy="12" r="10" /><path d="M8.5 10v7M8.5 7v.01M12 10h2.2a3.5 3.5 0 0 1 0 7H12Z" /></>)}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></>)}
  {name === 'x' && <path d="m4 4 16 16M20 4 4 20" />}
  {name === 'cv' && (<><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></>)}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'external' && (<><path d="M14 4h6v6M20 4l-9 9" /><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" /></>)}
  {name === 'copy' && (<><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a1 1 0 0 1 1-1h10" /></>)}
  {name === 'code' && <path d="m8 7-5 5 5 5M16 7l5 5-5 5" />}
  {name === 'paper' && (<><path d="M6 3h9l4 4v14H6Z" /><path d="M9 12h7M9 16h5" /></>)}
</svg>
