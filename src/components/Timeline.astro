---
import SectionHeader from './SectionHeader.astro';

export interface TimelineItem {
  title: string;
  org: string;
  period: string;
  meta?: string;
  points?: string[];
}

interface Props {
  id: string;
  index: string;
  title: string;
  kicker: string;
  items: TimelineItem[];
}
const { id, index, title, kicker, items } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <SectionHeader index={index} title={title} kicker={kicker} />

    <ol class="timeline">
      {
        items.map((item, i) => (
          <li class="reveal" style={`--i: ${i}`}>
            <span class="node" aria-hidden="true" />
            <p class="period mono">{item.period}</p>
            <div class="entry">
              <h3>{item.title}</h3>
              <p class="org">
                {item.org}
                {item.meta && <span class="meta mono"> · {item.meta}</span>}
              </p>
              {item.points && item.points.length > 0 && (
                <ul class="points">
                  {item.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
  }

  /* The glowing rail */
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: linear-gradient(180deg, var(--accent), var(--violet) 60%, transparent);
    opacity: 0.6;
  }

  .timeline > li {
    position: relative;
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 4px 32px;
    padding-bottom: 36px;
  }

  .timeline > li:last-child {
    padding-bottom: 0;
  }

  .node {
    position: absolute;
    left: -28px;
    top: 7px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
    box-shadow: 0 0 0 4px rgb(56 225 255 / 0.12), 0 0 16px rgb(56 225 255 / 0.5);
  }

  .period {
    margin: 2px 0 0;
    color: var(--accent);
    font-size: 0.8rem;
  }

  h3 {
    font-size: 1.2rem;
  }

  .org {
    margin: 4px 0 0;
    color: var(--muted);
  }

  .meta {
    color: var(--dim);
    font-size: 0.8rem;
  }

  .points {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    color: #c3cede;
  }

  .points li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 6px;
  }

  .points li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .timeline > li {
      grid-template-columns: 1fr;
    }
  }
</style>
